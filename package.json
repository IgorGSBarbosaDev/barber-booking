{
  "name": "barber-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Estrutura inicial para o sistema de agendamento da barbearia.",
  "scripts": {
    "test": "node scripts/validate.mjs",
    "push:public": "clasp -P apps/public push",
    "push:admin": "clasp -P apps/admin push",
    "pull:public": "clasp -P apps/public pull",
    "pull:admin": "clasp -P apps/admin pull",
    "status:public": "clasp -P apps/public status",
    "status:admin": "clasp -P apps/admin status",
    "version:clasp": "clasp --version"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
